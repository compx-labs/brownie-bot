# Brownie Bot environment template.
# Copy to .env and fill secrets. Never commit .env.
#
# Required vs optional: README.md#environment-variables
# Troubleshooting: README.md#ops-troubleshooting

# === Required ===
# Treasury address used for Canix personalization (and signing when enabled).
BOT_WALLET=
# 25-word mnemonic. Pays Canix x402 and inference; never sent to MCP/Telegram/logs.
WALLET_MNEMONIC=

# === Required for Docker ===
# Encrypts the in-container zs-proxy file keyring. Not used by local Node + host zs-proxy.
ZEROSIGNAL_KEYSTORE_PASSPHRASE=  # pragma: allowlist secret

# === Optional — Telegram (set both or neither) ===
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# === Optional — DigitalOcean Spaces (set all four or none) ===
# Otherwise accounting JSON is stored under ACCOUNTING_DATA_DIR.
# DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# DO_SPACES_REGION=nyc3
# DO_SPACES_BUCKET=
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# DO_SPACES_PREFIX=brownie-bot

# === Optional — inference / zs-proxy (defaults usually fine) ===
# Host-local zs-proxy /v1 and SDK placeholder key default in src/config.ts.
# OPENAI_BASE_URL=
# OPEN_AI_API_KEY=
# OPENAI_MODEL=glm-5.2
# OPENAI_REASONING_EFFORT=medium
# AI_MODE=full
# AI_MAX_TOOL_CALLS=16

# === Optional — runtime ===
# NODE_ENV=
# HOST=0.0.0.0
# PORT=3000
# RUN_CRON=false
# Review cron expression defaults in src/config.ts
# CRON_SCHEDULE=
# CRON_TIMEZONE=UTC
# ≥16 chars enables POST /runs and POST /accounting/run (Bearer token).
# Unset → those routes 404. See README.md#force-a-review.
# MANUAL_TRIGGER_TOKEN=
# CANIX402_MCP_URL=https://canix402-mcp.compx.io/mcp
# X402_ALGOD_URL=https://mainnet-api.algonode.cloud
# X402_INDEXER_URL=https://mainnet-idx.algonode.cloud
# Accounting cron expression defaults in src/config.ts
# ACCOUNTING_CRON_SCHEDULE=
# ACCOUNTING_CRON_TIMEZONE=UTC
# ACCOUNTING_DATA_DIR=data/accounting
# FOLKS_ESCROW_DATA_DIR=data/folks-escrows

# === Optional — policy (see POLICY.md; do not change lightly) ===
# ENABLE_TRANSACTION_SIGNING=false
# MAX_POSITION_PCT=35
# MAX_PROTOCOL_PCT=50
# MIN_LIQUID_RESERVE_PCT=10
# MIN_TVL_USD=6000
# MAX_SOURCE_AGE_HOURS=24
# MAX_SLIPPAGE_BPS=100
# MAX_PRICE_IMPACT_PCT=3
# MAX_DAILY_X402_BASE_UNITS=5000000
# MAX_DAILY_ZS_USDC=5
# MIN_PROJECTED_NET_IMPROVEMENT_USD=1
# PREFERRED_HOLD_ASSETS=

# === Optional — Docker zs-proxy overrides ===
# PROXY_SPEND_DAILY_CAP_USDC=5
# PROXY_SPEND_PER_REQUEST_CAP_USDC=1
# PROXY_ZS_PRIVACY=false
# PROXY_ZS_PROXY_PAYER_ADDR=

# === Optional — protocol verify (dedicated wallet; never reuse BOT_WALLET) ===
# TEST_WALLET=
# TEST_MNEMONIC=
# PROTOCOL_VERIFY_AMOUNT_USDC=1
# PROTOCOL_VERIFY_AMOUNT_ALGO=1
# PROTOCOL_VERIFY_AMOUNT_ORA=1
# PROTOCOL_VERIFY_AMOUNT_COMPX=10
# PROTOCOL_VERIFY_AMOUNT_UNIT=0.1
